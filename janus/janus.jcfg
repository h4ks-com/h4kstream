# Janus Gateway main configuration
# Minimal configuration for streaming use case

general: {
	# Logging configuration
	debug_level = 4
	debug_timestamps = true
	debug_colors = false

	# API configuration
	# api_secret = ""  # Disabled for public streaming access
	admin_secret = ""

	# Session configuration
	session_timeout = 60
}

# NAT configuration
nat: {
	# STUN server for NAT traversal (dynamic public IP discovery)
	# Using IPv4 address directly to force IPv4 discovery (hostname resolves to IPv6 first)
	stun_server = "74.125.250.129"  # stun.l.google.com IPv4
	stun_port = 19302

	# Disable ice_lite mode - use full ICE
	ice_lite = false

	# Ignore Docker/Kubernetes internal networks to prevent advertising unreachable IPs
	# This forces Janus to only advertise the main network interface (eth0)
	# vmnet = VMware/VirtualBox, docker0 = Docker bridge, br- = Docker custom bridges, veth = Docker virtual ethernet
	ice_ignore_list = "vmnet,docker0,br-,veth"

	# Enable TCP as fallback
	ice_tcp = true

	# Enable full trickle ICE for better NAT traversal
	full_trickle = true

	# For Kubernetes with hostNetwork: comment out nat_1_1_mapping
	# to allow binding to all interfaces (0.0.0.0)
	# For Docker Compose: uncomment and set to "127.0.0.1"
	# nat_1_1_mapping = "127.0.0.1"

	# Keep connections alive
	keep_private_host = true
}

# Media configuration
media: {
	# RTP/RTCP port range for WebRTC media
	# Must be open in firewall/router for external clients
	# 2000 ports = ~1000 concurrent connections (more than enough for homelab)
	rtp_port_range = "20000-22000"
}

# HTTP transport
transports: {
	http: {
		enabled = true
		port = 8088
		base_path = "/janus"
		threads = "unlimited"
		http = true
		https = false
	}

	# WebSocket transport for low latency
	websockets: {
		enabled = true
		port = 8188
		ws = true
		wss = false
	}
}

# Plugins configuration
plugins: {
	# Disable plugins we don't need
	disable = "libjanus_echotest.so,libjanus_videocall.so,libjanus_videoroom.so,libjanus_textroom.so,libjanus_sip.so,libjanus_nosip.so,libjanus_recordplay.so"
}

# Events configuration (disabled for simplicity)
events: {
	broadcast = false
}

# Logging configuration
loggers: {
	# Console logging
	stdout: {
		enabled = true
	}
}
